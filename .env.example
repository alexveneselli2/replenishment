# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Strategy Mosaic OAuth2 credentials (client_credentials grant)
MOSAIC_CLIENT_ID=your-client-id
MOSAIC_CLIENT_SECRET=your-client-secret

# Optional: explicit token endpoint (auto-discovered if omitted)
MOSAIC_TOKEN_ENDPOINT=https://studio.strategy.com/MicroStrategyLibrary/oauth2/token

# Optional: base URL for well-known discovery (default: https://studio.strategy.com)
MOSAIC_BASE_URL=https://studio.strategy.com

# Optional: static bearer token (dev/testing shortcut — bypasses OAuth2)
# MOSAIC_TOKEN=your-static-token

# Server port (default: 3001)
# PORT=3001
